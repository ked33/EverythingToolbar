<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nord palette: https://www.nordtheme.com -->
    <!-- Polar Night: #2E3440 #3B4252 #434C5E #4C566A -->
    <!-- Snow Storm:  #D8DEE9 #E5E9F0 #ECEFF4 -->
    <!-- Frost:       #8FBCBB #88C0D0 #81A1C1 #5E81AC -->

    <!-- Darker frost for selected pill/tab text contrast (works for both Win10 underline and Win11 pill). -->
    <SolidColorBrush x:Key="AccentColor" Color="#5E81AC" />

    <Color x:Key="AcrylicWindowBackgroundFallback">#2E3440</Color>

    <SolidColorBrush x:Key="ContextMenuBorder" Color="#3B4252" />
    <SolidColorBrush x:Key="ContextMenuSeparator" Color="#434C5E" />
    <SolidColorBrush x:Key="ContextMenuItemBackgroundHover" Color="#3B4252" />
    <SolidColorBrush x:Key="ContextMenuItemBackgroundActive" Color="#434C5E" />
    <SolidColorBrush x:Key="ContextMenuItemForeground" Color="#D8DEE9" />
    <SolidColorBrush x:Key="ContextMenuItemForegroundHover" Color="#ECEFF4" />
    <SolidColorBrush x:Key="ContextMenuItemForegroundActive" Color="#ECEFF4" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#2E3440" />

    <SolidColorBrush x:Key="TextBoxBackground" Color="#3B4252" />
    <SolidColorBrush x:Key="TextBoxBackgroundHover" Color="#434C5E" />
    <SolidColorBrush x:Key="TextBoxBackgroundActive" Color="#3B4252" />
    <SolidColorBrush x:Key="TextBoxForeground" Color="#ECEFF4" />
    <SolidColorBrush x:Key="TextBoxForegroundHover" Color="#ECEFF4" />
    <SolidColorBrush x:Key="TextBoxForegroundActive" Color="#ECEFF4" />
    <SolidColorBrush x:Key="TextBoxWatermarkForeground" Color="#4C566A" />
    <SolidColorBrush x:Key="TextBoxWatermarkForegroundHover" Color="#4C566A" />
    <SolidColorBrush x:Key="TextBoxWatermarkForegroundActive" Color="#D8DEE9" />
    <SolidColorBrush x:Key="TextBoxBorder" Color="#4C566A" />
    <SolidColorBrush x:Key="TextBoxBorderHover" Color="#81A1C1" />
    <SolidColorBrush x:Key="TextBoxBorderActive" Color="#5E81AC" />

    <SolidColorBrush x:Key="SearchBoxIconColor" Color="#D8DEE9" />

    <SolidColorBrush x:Key="QuickSettingsToggleButtonBackgroundHover" Color="#3B4252" />
    <SolidColorBrush x:Key="QuickSettingsToggleButtonBackgroundActive" Color="#434C5E" />
    <SolidColorBrush x:Key="QuickSettingsToggleButtonBorderHover" Color="Transparent" />
    <SolidColorBrush x:Key="QuickSettingsToggleButtonBorderActive" Color="Transparent" />

    <SolidColorBrush x:Key="SearchResultsViewBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TabBarBottomBorder" Color="Transparent" />
    <SolidColorBrush x:Key="SearchResultsViewHeader" Color="#E52E3440" />
    <SolidColorBrush x:Key="SearchResultsViewSpinner" Color="#88C0D0" />

    <SolidColorBrush x:Key="TabBackground" Color="#3B4252" />
    <SolidColorBrush x:Key="TabBackgroundHover" Color="#434C5E" />
    <SolidColorBrush x:Key="TabBorder" Color="#4C566A" />
    <SolidColorBrush x:Key="TabForeground" Color="#D8DEE9" />
    <SolidColorBrush x:Key="TabForegroundHover" Color="#ECEFF4" />
    <!-- Active label sits on AccentColor (Win11) or dark chrome (Win10); always keep it light. -->
    <SolidColorBrush x:Key="TabForegroundActive" Color="#ECEFF4" />

    <SolidColorBrush x:Key="TabBarButtonForeground" Color="#D8DEE9" />
    <SolidColorBrush x:Key="TabBarButtonForegroundHover" Color="#ECEFF4" />
    <SolidColorBrush x:Key="TabBarButtonForegroundActive" Color="#ECEFF4" />
    <SolidColorBrush x:Key="TabBarButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TabBarButtonBackgroundHover" Color="#3B4252" />
    <SolidColorBrush x:Key="TabBarButtonBackgroundActive" Color="#434C5E" />

    <SolidColorBrush x:Key="SearchResultBackgroundHover" Color="#3B4252" />
    <SolidColorBrush x:Key="SearchResultBackgroundActive" Color="#434C5E" />
    <SolidColorBrush x:Key="PreviewActionButtonBackgroundHover" Color="#3B4252" />
    <SolidColorBrush x:Key="PreviewActionButtonBackgroundActive" Color="#434C5E" />
    <SolidColorBrush x:Key="SearchResultFileName" Color="#ECEFF4" />
    <SolidColorBrush x:Key="SearchResultPath" Color="#81A1C1" />
    <SolidColorBrush x:Key="SearchResultDateModified" Color="#4C566A" />
    <SolidColorBrush x:Key="SearchResultFileSize" Color="#4C566A" />

    <SolidColorBrush x:Key="ScrollbarBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonFill" Color="#4C566A" />
    <SolidColorBrush x:Key="ScrollbarButtonFillHover" Color="#81A1C1" />
    <SolidColorBrush x:Key="ScrollbarButtonFillActive" Color="#88C0D0" />
    <SolidColorBrush x:Key="ScrollbarButtonStroke" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonStrokeHover" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonStrokeActive" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonBackgroundHover" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonBackgroundActive" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarThumbBackground" Color="#4C566A" />
    <SolidColorBrush x:Key="ScrollbarThumbBackgroundHover" Color="#81A1C1" />
    <SolidColorBrush x:Key="ScrollbarThumbBackgroundActive" Color="#88C0D0" />

</ResourceDictionary>
