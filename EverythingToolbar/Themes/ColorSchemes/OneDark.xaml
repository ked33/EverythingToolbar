<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One Dark palette (Atom / common IDE variant) -->
    <!-- BG: #282C34  Gutter: #21252B  Selection: #3E4451  FG: #ABB2BF -->
    <!-- Blue: #61AFEF  Cyan: #56B6C2  Comment: #5C6370 -->

    <SolidColorBrush x:Key="AccentColor" Color="#61AFEF" />

    <Color x:Key="AcrylicWindowBackgroundFallback">#282C34</Color>

    <SolidColorBrush x:Key="ContextMenuBorder" Color="#181A1F" />
    <SolidColorBrush x:Key="ContextMenuSeparator" Color="#3E4451" />
    <SolidColorBrush x:Key="ContextMenuItemBackgroundHover" Color="#2C313C" />
    <SolidColorBrush x:Key="ContextMenuItemBackgroundActive" Color="#3E4451" />
    <SolidColorBrush x:Key="ContextMenuItemForeground" Color="#ABB2BF" />
    <SolidColorBrush x:Key="ContextMenuItemForegroundHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContextMenuItemForegroundActive" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#21252B" />

    <SolidColorBrush x:Key="TextBoxBackground" Color="#21252B" />
    <SolidColorBrush x:Key="TextBoxBackgroundHover" Color="#2C313C" />
    <SolidColorBrush x:Key="TextBoxBackgroundActive" Color="#21252B" />
    <SolidColorBrush x:Key="TextBoxForeground" Color="#ABB2BF" />
    <SolidColorBrush x:Key="TextBoxForegroundHover" Color="#ABB2BF" />
    <SolidColorBrush x:Key="TextBoxForegroundActive" Color="#ABB2BF" />
    <SolidColorBrush x:Key="TextBoxWatermarkForeground" Color="#5C6370" />
    <SolidColorBrush x:Key="TextBoxWatermarkForegroundHover" Color="#5C6370" />
    <SolidColorBrush x:Key="TextBoxWatermarkForegroundActive" Color="#7F848E" />
    <SolidColorBrush x:Key="TextBoxBorder" Color="#3E4451" />
    <SolidColorBrush x:Key="TextBoxBorderHover" Color="#528BFF" />
    <SolidColorBrush x:Key="TextBoxBorderActive" Color="#61AFEF" />

    <SolidColorBrush x:Key="SearchBoxIconColor" Color="#ABB2BF" />

    <SolidColorBrush x:Key="QuickSettingsToggleButtonBackgroundHover" Color="#2C313C" />
    <SolidColorBrush x:Key="QuickSettingsToggleButtonBackgroundActive" Color="#3E4451" />
    <SolidColorBrush x:Key="QuickSettingsToggleButtonBorderHover" Color="Transparent" />
    <SolidColorBrush x:Key="QuickSettingsToggleButtonBorderActive" Color="Transparent" />

    <SolidColorBrush x:Key="SearchResultsViewBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TabBarBottomBorder" Color="Transparent" />
    <SolidColorBrush x:Key="SearchResultsViewHeader" Color="#E5282C34" />
    <SolidColorBrush x:Key="SearchResultsViewSpinner" Color="#61AFEF" />

    <SolidColorBrush x:Key="TabBackground" Color="#21252B" />
    <SolidColorBrush x:Key="TabBackgroundHover" Color="#2C313C" />
    <SolidColorBrush x:Key="TabBorder" Color="#3E4451" />
    <SolidColorBrush x:Key="TabForeground" Color="#ABB2BF" />
    <SolidColorBrush x:Key="TabForegroundHover" Color="#FFFFFF" />
    <!-- Active label sits on AccentColor (Win11) or dark chrome (Win10); always keep it light. -->
    <SolidColorBrush x:Key="TabForegroundActive" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TabBarButtonForeground" Color="#ABB2BF" />
    <SolidColorBrush x:Key="TabBarButtonForegroundHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabBarButtonForegroundActive" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabBarButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TabBarButtonBackgroundHover" Color="#2C313C" />
    <SolidColorBrush x:Key="TabBarButtonBackgroundActive" Color="#3E4451" />

    <SolidColorBrush x:Key="SearchResultBackgroundHover" Color="#2C313C" />
    <SolidColorBrush x:Key="SearchResultBackgroundActive" Color="#3E4451" />
    <SolidColorBrush x:Key="PreviewActionButtonBackgroundHover" Color="#2C313C" />
    <SolidColorBrush x:Key="PreviewActionButtonBackgroundActive" Color="#3E4451" />
    <SolidColorBrush x:Key="SearchResultFileName" Color="#ABB2BF" />
    <SolidColorBrush x:Key="SearchResultPath" Color="#5C6370" />
    <SolidColorBrush x:Key="SearchResultDateModified" Color="#5C6370" />
    <SolidColorBrush x:Key="SearchResultFileSize" Color="#5C6370" />

    <SolidColorBrush x:Key="ScrollbarBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonFill" Color="#5C6370" />
    <SolidColorBrush x:Key="ScrollbarButtonFillHover" Color="#ABB2BF" />
    <SolidColorBrush x:Key="ScrollbarButtonFillActive" Color="#61AFEF" />
    <SolidColorBrush x:Key="ScrollbarButtonStroke" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonStrokeHover" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonStrokeActive" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonBackgroundHover" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarButtonBackgroundActive" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarThumbBackground" Color="#5C6370" />
    <SolidColorBrush x:Key="ScrollbarThumbBackgroundHover" Color="#ABB2BF" />
    <SolidColorBrush x:Key="ScrollbarThumbBackgroundActive" Color="#61AFEF" />

</ResourceDictionary>
