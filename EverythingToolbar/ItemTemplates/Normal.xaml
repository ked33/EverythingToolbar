<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:h="clr-namespace:EverythingToolbar.Helpers">
  <DataTemplate x:Key="Normal">
    <Grid x:Name="ListViewItem" Margin="0 0 0 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image
        Width="16"
        Height="16"
        Margin="0 5 0 0"
        b:ResultIcon.Result="{Binding Mode=OneTime}" />
      <Grid
        Grid.Column="1"
        Margin="0 4 10 4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Margin="0 0 12 0"
          VerticalAlignment="Center"
          h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
          FontSize="12pt"
          Foreground="{DynamicResource SearchResultFileName}"
          TextTrimming="CharacterEllipsis"
          ToolTip="{Binding FileName, Mode=OneTime}" />
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          h:HighlightedText.Source="{Binding HighlightedPath, Mode=OneTime}"
          FontSize="10pt"
          Foreground="{DynamicResource SearchResultPath}"
          TextTrimming="CharacterEllipsis"
          ToolTip="{Binding Path, Mode=OneTime}" />
      </Grid>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
